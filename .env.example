# Copy to .env.local for local development. On Vercel, set these in
# Project > Settings > Environment Variables instead.

# Browser (safe to expose): Supabase > Project Settings > API
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-publishable-key   # sb_publishable_... (or legacy anon key)

# Server only (never prefix with REACT_APP_)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-secret-key   # sb_secret_... (or legacy service_role key)
ELEVENLABS_API_KEY=your-elevenlabs-key
ELEVENLABS_AGENT_ID=agent_xxxxxxxx

# Optional AI keys for server-side replies (email, deal-stage replies)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Security and cost controls
ADMIN_EMAILS=you@example.com         # who may change the gold standard (comma separated)
AI_DAILY_LIMIT_PER_USER=150          # AI replies per user per day
AI_DAILY_LIMIT_TOTAL=2000            # AI replies per day across all users
VOICE_DAILY_LIMIT_PER_USER=15        # voice calls per user per day
VOICE_DAILY_LIMIT_TOTAL=150          # voice calls per day across all users
