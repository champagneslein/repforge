# Copy to .env.local for local development. On Vercel, set these in
# Project > Settings > Environment Variables instead.

# Browser (safe to expose): Supabase > Project Settings > API
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-public-key

# Server only (never prefix with REACT_APP_)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ELEVENLABS_API_KEY=your-elevenlabs-key
ELEVENLABS_AGENT_ID=agent_xxxxxxxx
